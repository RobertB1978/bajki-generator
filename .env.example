# Backend (FastAPI)
# Prefix wszystkich endpointów API. Zmień, jeżeli backend ma działać pod inną ścieżką.
BAJKI_API_PREFIX=/api
# Lista dozwolonych originów frontendowych oddzielona przecinkami.
BAJKI_FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Domyślny język bajek generowanych przez usługę.
BAJKI_DEFAULT_LANGUAGE=pl

# Skrypt CLI (scripts/story_cli.py)
# Adres bazowy używany przez narzędzia developerskie do komunikacji z API.
BAJKI_API_URL=http://localhost:8000/api

# Frontend (Vite)
# Bazowy adres API, z którego korzysta aplikacja webowa.
VITE_API_BASE_URL=http://localhost:8000/api
